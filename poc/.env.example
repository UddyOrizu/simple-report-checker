# Postgres connection string used by SQLAlchemy/Alembic (async driver for the app, sync for alembic)
DATABASE_URL=postgresql+asyncpg://poc:poc@localhost:5433/claim_checker

# Required for all Agno/Claude-backed agents: decomposer, verifier, challenger,
# section summarizer, semantic domain classifier fallback.
# Without this set, LLM-dependent pipeline stages are BLOCKED-CREDENTIALS —
# deterministic stages (ingestion, chunking, structural indexing, arithmetic
# verification) still run fully.
ANTHROPIC_API_KEY=

# Local file storage root for uploaded documents
STORAGE_DIR=./storage

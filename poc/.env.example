# Postgres connection string used by SQLAlchemy/Alembic (async driver for the app, sync for alembic)
DATABASE_URL=postgresql+asyncpg://poc:poc@localhost:5433/claim_checker

# Which LLM backend every Agno-backed agent uses: decomposer, verifier, challenger,
# section summarizer, semantic domain classifier fallback, external evidence team.
# "anthropic" (default) or "openai" — set the matching API key below for whichever
# you pick. Without that key set, LLM-dependent pipeline stages are
# BLOCKED-CREDENTIALS — deterministic stages (ingestion, chunking, structural
# indexing, arithmetic verification) still run fully.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Only used when LLM_PROVIDER=openai and you're routing through a proxy/gateway
# instead of api.openai.com directly.
OPENAI_BASE_URL=

# Internal-claim verification vote panel (app/agents/internal_vote_panel.py). "standard"/"mini"
# use whichever LLM_PROVIDER above is active; "fino1" calls TheFinAI/Fin-o1-8B via a Hugging Face
# Inference Endpoint using HF_TOKEN below. A voter that errors (e.g. HF_TOKEN unset) is dropped
# from the vote rather than blocking verification, so this is safe to leave at the default even
# without an HF token — the panel just falls back to 2 voters.
INTERNAL_VERIFICATION_VOTERS=standard,mini,fino1
HF_TOKEN= 
FINO1_MODEL_ID=TheFinAI/Fin-o1-8B
# Only set this if Fin-o1-8B is deployed as a dedicated HF Inference Endpoint rather than through
# HF's shared serverless Inference Providers routing.
HF_INFERENCE_BASE_URL=

# Local file storage root for uploaded documents
STORAGE_DIR=./storage 
